# Copy to .env.hosted.local for check:hosting. Never publish the filled file.
# These values are server configuration, never frontend variables.
APP_ORIGIN=https://replace-with-your-course-host.example
SUPABASE_URL=https://replace-with-production-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Generate a fresh stable 32-byte base64 secret. Store as a Worker secret.
# Changing this value signs out all gateway sessions.
SESSION_SECRET=

# Default closed. Pilot admits only the private list below. No automatic opening.
REGISTRATION_MODE=closed
PILOT_EMAILS=
# Public mode requires this true AFTER both auth methods are configured/tested.
GOOGLE_AUTH_ENABLED=false

# Optional. Bucket must be private; store registry as a secret, not a public file.
# PRIVATE_MEDIA_BUCKET=course-private
# PRIVATE_MEDIA_ENTRIES=[]
