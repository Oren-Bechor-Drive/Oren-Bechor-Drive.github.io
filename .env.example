# Copy to .env.local. All values are read by Node, never by browser JavaScript.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=https://zurpazevlvtylnzvagoo.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only sb_secret key, or the legacy service_role key. Never commit it.
SUPABASE_SECRET_KEY=
# Enable only after configuring the Google provider in Supabase.
GOOGLE_AUTH_ENABLED=false

# Optional private media, outside this repository. Both are required together.
